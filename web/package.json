{
  "name": "remote-agent-web",
  "private": true,
  "type": "module",
  "scripts": {
    "core": "../scripts/core/build.sh web",
    "dev": "pnpm core && vite",
    "build": "pnpm core && tsc -b && vite build && node scripts/report-first-paint-size.mjs",
    "preview": "vite preview",
    "gen": "buf generate --template buf.gen.yaml",
    "test": "pnpm core && vitest run",
    "typecheck": "pnpm core && tsc -b",
    "deploy": "VITE_DEFAULT_SERVER=${VITE_DEFAULT_SERVER:-https://relay.remote-agent.top} pnpm build && wrangler pages deploy dist --project-name remote-agent --branch main"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.52.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtuoso": "^4.18.16"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.14.5",
    "scslre": "0.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.1"
  }
}
