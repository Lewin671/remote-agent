{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remote Agent message domain",
  "description": "Authoritative source; scripts/i18n.py also checks cross-locale/platform semantics. One selector per message; no nesting.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "key",
      "zh-CN",
      "en",
      "notes",
      "params",
      "platforms",
      "status"
    ],
    "properties": {
      "key": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      },
      "zh-CN": {
        "oneOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plural",
              "forms"
            ],
            "properties": {
              "plural": {
                "type": "string"
              },
              "forms": {
                "$ref": "#/$defs/forms"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "select",
              "forms"
            ],
            "properties": {
              "select": {
                "type": "string"
              },
              "forms": {
                "$ref": "#/$defs/forms"
              }
            }
          }
        ]
      },
      "en": {
        "oneOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plural",
              "forms"
            ],
            "properties": {
              "plural": {
                "type": "string"
              },
              "forms": {
                "$ref": "#/$defs/forms"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "select",
              "forms"
            ],
            "properties": {
              "select": {
                "type": "string"
              },
              "forms": {
                "$ref": "#/$defs/forms"
              }
            }
          }
        ]
      },
      "notes": {
        "type": "string",
        "minLength": 1
      },
      "params": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "example"
          ],
          "properties": {
            "type": {
              "enum": [
                "string",
                "integer",
                "number"
              ]
            },
            "example": {
              "type": [
                "string",
                "integer",
                "number"
              ]
            }
          }
        }
      },
      "platforms": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "web",
            "android",
            "ios",
            "go"
          ]
        }
      },
      "status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zh-CN",
          "en"
        ],
        "properties": {
          "zh-CN": {
            "enum": [
              "source",
              "reviewed"
            ]
          },
          "en": {
            "enum": [
              "draft",
              "reviewed"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "forms": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "other"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    }
  }
}
