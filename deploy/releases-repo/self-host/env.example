# Copy to .env and fill in. Keep .env private: the setup token creates the account.

# The domain of this relay. Its DNS record must point at this machine.
RELAY_DOMAIN=ra.example.com

# Where you host the web client, comma-separated if more than one.
ALLOWED_ORIGINS=https://app.example.com

# Asked for once by `remote-agent account init`. Use a long random value,
# for example: openssl rand -base64 24 | tr '+/' '-_'
RA_SETUP_TOKEN=
