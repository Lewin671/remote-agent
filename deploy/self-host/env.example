# Copy to .env and fill in. Keep .env private: the setup token creates accounts.

# The domain of this relay. Its DNS record must point at this machine.
RELAY_DOMAIN=ra.example.com

# Where you host the web client, comma-separated if more than one.
ALLOWED_ORIGINS=https://app.example.com

# Asked for once by `remote-agent account init`. Use a long random value,
# for example: openssl rand -base64 24 | tr '+/' '-_'
RA_SETUP_TOKEN=

# Who may create an account here: token (the default) for a relay of your
# own, where only the setup token creates one; open to let anyone create a
# trial account with a proof of work, for others to try remote-agent.
# RA_SIGNUP=token

# Most accounts on this relay. 0 means 1 with token signup, 100 with open.
# RA_MAX_ACCOUNTS=0
