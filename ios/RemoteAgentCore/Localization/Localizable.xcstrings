    "image_attach_failed": {
      "comment": "Generated by scripts/i18n.py; DO NOT EDIT. 会话输入框附件失败汇总，一行说明，可换行。count 是本机失败图片数（非用户内容），点各图片可见原因；不暴露原始系统异常。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%1$lld image could not be attached. Tap it for details."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%1$lld images could not be attached. Tap an image for details."
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%1$lld 张图没加上，点图片看原因"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "version": "1.0"
